# Kopiere diese Datei nach .env.local (wird nicht committet) und trage die Werte
# aus Supabase → Project Settings → API ein. Ohne diese Werte arbeitet die App
# nur lokal und hat keinerlei Verbindung nach außen.
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-public-key
# Niemals den service_role-Key eintragen!

# Optional: Gmail nur lesend (Anleitung: docs/gmail-einrichtung.md).
# Die Client-ID ist öffentlich; ein Client-Secret wird nicht gebraucht.
VITE_GOOGLE_CLIENT_ID=
